# Build-time Wi-Fi credentials, kept out of the repository entirely.
#
# The SSID and password live in files outside the tree - `~/.wifi_ssid` and
# `~/.wifi_pass`, mode 600 - and are read here into a header that is generated
# **inside the build directory**. That location is the safety property: `build/`
# has been in `firmware/.gitignore` since the first commit, so the generated
# file cannot be added to the index even by `git add -A`. `firmware/.gitignore`
# names `wifi_credentials.h` as well, so it stays ignored if it is ever
# generated somewhere else.
#
# Nothing here echoes either value. Not `message()`, not a comment in the
# generated header, not a variable name that carries it into a log. A secret
# printed once during a build is a secret in a scrollback, a CI log and a pasted
# bug report.
#
# The credentials are compiled into the firmware image, which is unavoidable for
# a station that has to authenticate; `build/` is ignored, so no image carrying
# them is committed either.

# Turn a file's contents into a C string literal body, or "" when it is missing.
function(_sps30_read_secret path out_var out_present)
    if(NOT EXISTS "${path}")
        set(${out_var} "" PARENT_SCOPE)
        set(${out_present} FALSE PARENT_SCOPE)
        return()
    endif()
    file(READ "${path}" raw)
    # Only the trailing newline goes: a password may legitimately begin or end
    # with a space, and STRIP would silently eat it and produce an auth failure
    # nobody could explain.
    string(REGEX REPLACE "[\r\n]+$" "" raw "${raw}")
    # Escape what a C string literal cannot carry raw.
    string(REPLACE "\\" "\\\\" raw "${raw}")
    string(REPLACE "\"" "\\\"" raw "${raw}")
    set(${out_var} "${raw}" PARENT_SCOPE)
    if(raw STREQUAL "")
        set(${out_present} FALSE PARENT_SCOPE)
    else()
        set(${out_present} TRUE PARENT_SCOPE)
    endif()
endfunction()

# Writes ${out_dir}/wifi_credentials.h. Add ${out_dir} to the include path of
# whichever target needs it - only `main.c` should.
function(sps30_generate_wifi_credentials out_dir)
    set(ssid_file "$ENV{SPS30_WIFI_SSID_FILE}")
    if(ssid_file STREQUAL "")
        set(ssid_file "$ENV{HOME}/.wifi_ssid")
    endif()
    set(pass_file "$ENV{SPS30_WIFI_PASS_FILE}")
    if(pass_file STREQUAL "")
        set(pass_file "$ENV{HOME}/.wifi_pass")
    endif()

    _sps30_read_secret("${ssid_file}" ssid ssid_present)
    _sps30_read_secret("${pass_file}" pass pass_present)

    if(ssid_present)
        set(present 1)
        # Says that credentials were found, never which. The path is the
        # captain's own dotfile name and carries nothing secret.
        message(STATUS "Wi-Fi credentials: found (SSID redacted), from ${ssid_file}")
    else()
        set(present 0)
        message(STATUS "Wi-Fi credentials: none at ${ssid_file}; the firmware will "
                       "run without networking")
    endif()
    if(ssid_present AND NOT pass_present)
        message(STATUS "Wi-Fi credentials: no password file; joining as an open network")
    endif()

    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${out_dir}/wifi_credentials.h"
"/* Generated by cmake/wifi_credentials.cmake. Do not edit, do not commit.
 *
 * This file holds a secret. It is written into the build directory, which is
 * gitignored, and is regenerated on every cmake configure.
 */
#pragma once

#define WIFI_CREDENTIALS_PRESENT ${present}
#define WIFI_SSID \"${ssid}\"
#define WIFI_PASSWORD \"${pass}\"
")

    # Reconfigure when either file changes, so editing a credential and
    # rebuilding does the obvious thing rather than flashing the old one.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                 "${ssid_file}" "${pass_file}")
endfunction()
